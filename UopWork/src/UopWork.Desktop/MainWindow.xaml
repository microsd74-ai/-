<Window x:Class="UopWork.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UOP WORK" WindowStyle="None" ResizeMode="NoResize" Width="1600" Height="900" MinWidth="1180" MinHeight="700" Closing="WindowClosing">
<Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
<Border Style="{StaticResource Panel}" Padding="12,8" Margin="0,0,0,10"><DockPanel>
 <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="ThemePicker" Width="150" Margin="0,0,12,0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="Светлая" Tag="Light"/><ComboBoxItem Content="Тёмная" Tag="Dark"/><ComboBoxItem Content="Ретро-терминал" Tag="Terminal"/></ComboBox><Button Content="🔒  Управление" Click="ManageClick"/></StackPanel>
 <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="//" Foreground="{DynamicResource AccentBrush}" FontSize="27" FontStyle="Italic" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="UOP WORK" FontSize="27" FontStyle="Italic" FontWeight="Bold"/><TextBlock Text="Мониторинг печати" Margin="24,8,20,0" FontSize="17"/><TextBlock Text="{Binding Attention}" VerticalAlignment="Center" Foreground="#EF737E"/></StackPanel><TextBlock Text="{Binding ModeLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel>
</DockPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Panel}" Margin="0,0,10,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Принтеры" FontSize="21" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,12,0,0"/><ListBox x:Name="PrintersList" ItemsSource="{Binding Printers}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/></DockPanel><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Margin="19,6,0,0"/><TextBlock Text="{Binding Layers}" Style="{StaticResource Muted}" Margin="19,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Grid Grid.Column="1" Margin="0,0,10,0" DataContext="{Binding Selected}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="104"/><RowDefinition Height="32"/><RowDefinition Height="2*" MinHeight="120"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="64"/></Grid.RowDefinitions>
<DockPanel Margin="4,0,4,8"><TextBlock DockPanel.Dock="Right" Text="{Binding Freshness}" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="{Binding Name,TargetNullValue=Выберите принтер}" FontSize="25" FontWeight="Bold"/></DockPanel>
<Border Grid.Row="1" CornerRadius="7" Background="{Binding AlarmBrush,TargetNullValue=#675020}" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding ErrorTitle,TargetNullValue=Ожидание подключения}" Foreground="White" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding ErrorDetail}" Foreground="White" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
<UniformGrid Grid.Row="2" Columns="5"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Слои" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Layers,TargetNullValue=—}" FontSize="22" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Окончание" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Finish,TargetNullValue=—}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="{Binding FinishKind}" Style="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Температура" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Temperature,TargetNullValue=—}" FontSize="24" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Влажность" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Humidity,TargetNullValue=—}" FontSize="24" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="Без смены слоя" Style="{StaticResource Muted}"/><TextBlock Text="{Binding LayerTime,TargetNullValue=—}" FontSize="22" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="3" Margin="3,8,3,8"><ProgressBar Height="5" Maximum="100" Value="{Binding Progress}" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/><TextBlock Text="{Binding ProgressText}" FontSize="10" VerticalAlignment="Top"/></Grid>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}" Margin="0,0,6,0"><Grid><TextBlock Text="Камера 1 · зона печати" VerticalAlignment="Top" FontWeight="SemiBold"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="◉" FontSize="50" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Видео пока не подключено" Style="{StaticResource Muted}"/></StackPanel></Grid></Border><Border Grid.Column="1" Style="{StaticResource Panel}" Margin="6,0,0,0"><Grid><TextBlock Text="Камера 2 · зона печати" VerticalAlignment="Top" FontWeight="SemiBold"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="◉" FontSize="50" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Видео пока не подключено" Style="{StaticResource Muted}"/></StackPanel></Grid></Border></Grid>
<TextBlock Grid.Row="5" Text="{Binding FileInfo}" Style="{StaticResource Muted}" Margin="5,9"/>
<Border Grid.Row="6" Style="{StaticResource Panel}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Журнал принтера" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox Text="{Binding PrinterLog,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0" Padding="0" VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
</Grid>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Panel}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Сообщения об ошибках" FontSize="18" FontWeight="Bold"/><TextBlock Text="Все принтеры · последнее полученное" Style="{StaticResource Muted}" Margin="0,5,0,14"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ActiveAlarms}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#5B1723" BorderBrush="#D9495C" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding AlarmText}" Foreground="White" Margin="0,8"/><TextBlock Text="{Binding Freshness}" Foreground="#E1B9BE" FontSize="11"/><Button Content="{Binding AckText}" Click="AcknowledgeClick" Tag="{Binding}" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border><Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,10,0,0"><StackPanel><TextBlock Text="Состояние системы" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="Видео и звуковое оповещение пока недоступны. Передача заданий отключена." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border></Grid>
</Grid>
<Border Grid.Row="2" Style="{StaticResource Panel}" Padding="8" Margin="0,10,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="⟳  Перезагрузить" IsEnabled="False" ToolTip="Функция пока недоступна"/><Button Content="⏻  Выключить" IsEnabled="False" ToolTip="Функция пока недоступна"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="⇧  Загрузить задание" Style="{StaticResource Primary}" IsEnabled="False" ToolTip="Передача заданий сейчас недоступна"/><TextBlock Text="{Binding Selected.Name}" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource Muted}"/></StackPanel></DockPanel></Border>
</Grid></Window>
