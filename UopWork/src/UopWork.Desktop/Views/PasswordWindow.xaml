<Window x:Class="UopWork.Desktop.Views.PasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Вход в управление" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
<StackPanel Margin="28"><TextBlock x:Name="Heading" Text="Пароль администратора" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,20"/><StackPanel x:Name="OldPanel"><TextBlock Text="Текущий пароль"/><PasswordBox x:Name="OldPassword"/></StackPanel><StackPanel x:Name="NewPanel"><TextBlock Text="Новый пароль — от 8 символов"/><PasswordBox x:Name="NewPassword"/><TextBlock Text="Повторите новый пароль"/><PasswordBox x:Name="Confirmation"/></StackPanel><TextBlock x:Name="Error" Foreground="#EF737E" MinHeight="40" Margin="0,4,0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True"/><Button x:Name="Accept" Content="Войти" IsDefault="True" Style="{StaticResource Primary}" Click="Submit"/></StackPanel></StackPanel>
</Window>
